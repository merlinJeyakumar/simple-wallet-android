<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.SimpleWallet.PrimaryButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">@dimen/wallet_touch_target</item>
        <item name="cornerRadius">@dimen/wallet_radius_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">@dimen/wallet_text_label</item>
    </style>

    <style name="Widget.SimpleWallet.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/wallet_touch_target</item>
        <item name="cornerRadius">@dimen/wallet_radius_medium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.SimpleWallet.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">@dimen/wallet_radius_medium</item>
        <item name="boxCornerRadiusTopEnd">@dimen/wallet_radius_medium</item>
        <item name="boxCornerRadiusBottomStart">@dimen/wallet_radius_medium</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/wallet_radius_medium</item>
        <item name="boxStrokeColor">@color/wallet_outline</item>
        <item name="hintTextColor">@color/wallet_text_secondary</item>
    </style>

    <style name="Widget.SimpleWallet.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/wallet_radius_large</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/wallet_surface</item>
        <item name="strokeColor">@color/wallet_outline</item>
        <item name="strokeWidth">@dimen/wallet_stroke_width</item>
    </style>

    <style name="Widget.SimpleWallet.LoadingIndicator" parent="Widget.Material3.CircularProgressIndicator">
        <item name="android:indeterminate">true</item>
        <item name="indicatorColor">@color/wallet_primary</item>
        <item name="indicatorInset">0dp</item>
        <item name="indicatorSize">@dimen/wallet_touch_target</item>
        <item name="trackThickness">@dimen/wallet_space_4</item>
    </style>

    <style name="TextAppearance.SimpleWallet.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/wallet_text_primary</item>
        <item name="android:textSize">@dimen/wallet_text_headline</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.SimpleWallet.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/wallet_text_primary</item>
        <item name="android:textSize">@dimen/wallet_text_title</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.SimpleWallet.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/wallet_text_primary</item>
        <item name="android:textSize">@dimen/wallet_text_body</item>
    </style>

    <style name="TextAppearance.SimpleWallet.Supporting" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/wallet_text_secondary</item>
        <item name="android:textSize">@dimen/wallet_text_label</item>
    </style>
</resources>
